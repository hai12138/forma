# Forma-specific local overrides (optional).
# Copy to: coze-studio/.forma-local/.env  (gitignored)
#
# Base Coze runtime env remains:
#   docker/.env.debug  (from docker/.env.debug.example)
#
# Do NOT put production secrets here.
# Do NOT commit the real .forma-local/.env file.

# DataSource Credential encryption master key.
# Must decode to exactly 32 bytes (base64 or hex).
# Generate with:
#   node scripts/forma/local/forma-local.mjs gen-secret
# Preview mode can omit this (Credential features WARN).
# FORMA_SECRET_MASTER_KEY=

# Local mode hint for status output (preview | full-ai). Does not enable models by itself.
# FORMA_LOCAL_MODE=preview
