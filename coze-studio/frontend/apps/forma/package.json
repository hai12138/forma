    "@coze-arch/tailwind-config": "workspace:*",
    "@coze-arch/ts-config": "workspace:*",
    "@coze-arch/vitest-config": "workspace:*",
    "@rsbuild/core": "~1.1.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
